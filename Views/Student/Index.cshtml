@model StudentRegistrationViewModel
@{
    ViewData["Title"] = "Студенттік профиль жасау";
}

<div class="portal-hero">
    <div class="container">
        <div class="hero-copy">
            <span class="eyebrow">Студенттерге арналған қызметтер</span>
            <h1>Студенттік профиліңізді жасаңыз</h1>
            <p>Университет қауымдастығына қосылып, академиялық профиліңізді басқару үшін тіркеу формасын толтырыңыз.</p>
        </div>
    </div>
</div>

<div class="container registration-shell">
    <aside class="registration-tips">
        <div class="tips-card">
            <span class="tips-label">Тіркелу нұсқаулығы</span>
            <h2>Профильді төрт қадамда жасаңыз</h2>
            <div class="step-list">
                <div class="step active"><span>1</span><div><strong>Жеке ақпарат</strong><small>Аты, тегі, электрондық пошта және жасы</small></div></div>
                <div class="step"><span>2</span><div><strong>Академиялық ақпарат</strong><small>Факультет, курс және үлгерім көрсеткіші</small></div></div>
                <div class="step"><span>3</span><div><strong>Аккаунт қауіпсіздігі</strong><small>Қауіпсіз құпиясөз жасаңыз</small></div></div>
                <div class="step"><span>4</span><div><strong>Өзім туралы</strong><small>Өзіңіз туралы қысқаша мәлімет қосыңыз</small></div></div>
            </div>
            <div class="security-note">
                <span class="shield-icon">✓</span>
                <div><strong>Қауіпсіз тіркелу</strong><small>Құпиясөзіңіз көпшілікке көрсетілмейді.</small></div>
            </div>
        </div>
        <div class="student-stat">
            <strong>@(ViewBag.StudentCount ?? 0)</strong>
            <span>студент тіркелген</span>
        </div>
    </aside>

    <section class="form-card">
        <form asp-controller="Student" asp-action="Index" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

            <section class="form-section">
                <div class="section-heading"><span>01</span><div><h2>Жеке ақпарат</h2><p>Профиліңізді толтыру үшін жеке мәліметтеріңізді енгізіңіз.</p></div></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Атыңызды енгізіңіз" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Тегіңізді енгізіңіз" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="field-error"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Электрондық поштаңызды енгізіңіз" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" class="form-control" placeholder="18" />
                        <span asp-validation-for="Age" class="field-error"></span>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-heading"><span>02</span><div><h2>Академиялық ақпарат</h2><p>Университеттегі оқу туралы мәліметтеріңіз.</p></div></div>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Faculty" class="form-label"></label>
                        <input asp-for="Faculty" class="form-control" placeholder="Мысалы: Ақпараттық технологиялар факультеті" />
                        <span asp-validation-for="Faculty" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Course" class="form-label"></label>
                        <select asp-for="Course" class="form-select">
                            <option value="">Курсты таңдаңыз</option>
                            <option value="1">1-курс</option>
                            <option value="2">2-курс</option>
                            <option value="3">3-курс</option>
                            <option value="4">4-курс</option>
                        </select>
                        <span asp-validation-for="Course" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GPA" class="form-label"></label>
                        <input asp-for="GPA" class="form-control" placeholder="0.0–4.0" step="0.01" />
                        <span asp-validation-for="GPA" class="field-error"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+77001234567" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="field-error"></span>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-heading"><span>03</span><div><h2>Аккаунт қауіпсіздігі</h2><p>Аккаунтыңыз үшін сенімді құпиясөз орнатыңыз.</p></div></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Кемінде 8 таңба" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Құпиясөзді қайталаңыз" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-heading"><span>04</span><div><h2>Өзім туралы</h2><p>Міндетті емес: өзіңіз туралы қысқаша мәлімет жазыңыз.</p></div></div>
                <label asp-for="AboutMe" class="form-label"></label>
                <textarea asp-for="AboutMe" class="form-control" rows="4" maxlength="250" placeholder="Қысқаша мәлімет жазыңыз (ең көбі 250 таңба)..."></textarea>
                <div class="textarea-meta"><span asp-validation-for="AboutMe" class="field-error"></span><span id="characterCount">0 / 250</span></div>
            </section>

            <div class="form-actions">
                <button type="reset" class="btn btn-reset">Тазалау</button>
                <button type="submit" class="btn btn-primary btn-register">Студенттік профиль жасау <span aria-hidden="true">→</span></button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
